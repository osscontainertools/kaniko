{
  "name": "kaniko-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "initializeCommand": "mkdir -p /tmp/kaniko-tls-registry \"${localEnv:HOME}/.docker\"",
  "runArgs": [
    "--network=host"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/tmp/kaniko-tls-registry,target=/tmp/kaniko-tls-registry,type=bind",
    "source=${localEnv:HOME}/.docker,target=/root/.docker,type=bind,readonly"
  ],
  "containerEnv": {
    "DOCKER_CONFIG": "/root/.docker"
  }
}
