# mz961: enough cacheable steps that a build talks to the registry repeatedly,
# so the connection summary is meaningful.
FROM alpine:3.22.4@sha256:310c62b5e7ca5b08167e4384c68db0fd2905dd9c7493756d356e893909057601

RUN echo one > /one
RUN echo two > /two
RUN echo three > /three
RUN echo four > /four
RUN echo five > /five
