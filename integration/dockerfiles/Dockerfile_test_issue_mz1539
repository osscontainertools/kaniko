# mz1539: a quoted --build-arg value used in FROM is rejected, as docker rejects it
# kaniko lexed the base name a second time before the pull, which stripped the quotes.
# Since v1.29.2 the push planning parsed the once-lexed name and failed while the pull succeeded.
# FF_KANIKO_FROM_LEX_ONCE lexes once everywhere, so the quotes stay part of the name.
ARG BASE
FROM $BASE
RUN date > /date
