FROM debian AS base
RUN apt-get update \
    && apt-get install -y \
        libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

RUN touch /blubb
RUN setcap "cap_net_raw+ep" /blubb
# 1743: a file carrying capabilities inside a directory copied wholesale. The
# save path applied the capabilities to the directory itself, never to the
# files below it, so they were lost before the dependent stage saw them.
RUN mkdir /dir \
    && touch /dir/nested \
    && setcap "cap_net_raw+ep" /dir/nested

FROM debian

RUN apt-get update \
    && apt-get install -y \
        libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=base /blubb /
RUN getcap /blubb
COPY --from=base /dir /dir
RUN getcap /dir/nested
