# mz1177: a file the runtime mounts under a base image symlink, where the base ships a file of its own,
# fails since main@05bf52aa9 with "cannot move the mounted path /z/lib.so to /a/lib.so: the base
# image ships a file there".
ARG IMAGE_REPO
FROM busybox AS base
# one layer, so tar orders a ahead of z and the target exists when the link arrives
RUN mkdir /a && echo base > /a/lib.so && echo base > /a/b && ln -s /a /z

FROM ${IMAGE_REPO}test-issue-mz1177-base:latest
RUN echo mz1177 > /z/data && cat /a/data
RUN cat /z/b
