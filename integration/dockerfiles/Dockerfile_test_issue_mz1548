# mz1548: Through kaniko v1.29.x, --build-arg NAME with NAME unset in the environment
# became NAME= and overrode the ARG default with an empty value.
ARG IMAGE_REPO
FROM ${IMAGE_REPO}busybox
ARG UNSET_ARG=default
ARG EMPTY_ENV_ARG=default
ARG SET_ENV_ARG=default
ARG EXPLICIT_EMPTY=default
RUN printf 'UNSET=[%s]\nEMPTY_ENV=[%s]\nSET_ENV=[%s]\nEXPLICIT_EMPTY=[%s]\n' \
    "$UNSET_ARG" "$EMPTY_ENV_ARG" "$SET_ENV_ARG" "$EXPLICIT_EMPTY" > /out
