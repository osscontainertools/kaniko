# Multi-stage Dockerfile for testing warmer --target
FROM golang:1.20-alpine AS builder
WORKDIR /build
RUN echo "Building from golang" > /app.txt

FROM alpine:3.18 AS runtime
WORKDIR /app
COPY --from=builder /app.txt /app.txt
RUN echo "Runtime stage"

FROM busybox:latest AS debug
COPY --from=builder /app.txt /builder_app.txt
COPY --from=runtime /app.txt /runtime_app.txt
RUN echo "Debug stage"
