FROM alpine:latest AS build
RUN mkdir '/[dir]' && echo "hello directory" > '/[dir]/value'
RUN echo "hello file" > '/[data]'

FROM alpine:latest
COPY --from=build '/[[]data]' /data
COPY --from=build '/[[]dir]' /dir
COPY 'context/mz1373/[[]dir]' /context
RUN test "$(cat /data)" = "hello file"
RUN test "$(cat /dir/value)" = "hello directory"
RUN test "$(cat /context/value)" = "hello context"
RUN --mount=type=bind,from=build,source=/[dir],target=/mnt/dir \
    test "$(cat /mnt/dir/value)" = "hello directory"
RUN --mount=type=bind,from=build,source=/[data],target=/mnt/data \
    test "$(cat /mnt/data)" = "hello file"
RUN --mount=type=bind,source=context/mz1373/[dir],target=/mnt/context \
    test "$(cat /mnt/context/value)" = "hello context"
