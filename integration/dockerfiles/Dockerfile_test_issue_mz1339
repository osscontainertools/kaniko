# mz1339: through kaniko v1.29.0, ADD to a relative destination without a WORKDIR left the layer empty.
# The files reached the build filesystem, so a later RUN saw them, but not the image.
FROM busybox:1.38
ADD context/tars/file.tar localdir/
ADD https://raw.githubusercontent.com/osscontainertools/kaniko/main/README.md relative.md
ADD --unpack=true https://github.com/GoogleCloudPlatform/docker-credential-gcr/releases/download/v1.4.3/docker-credential-gcr_linux_386-1.4.3.tar.gz remotedir/
