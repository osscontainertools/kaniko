{
  "target": {
    "both": {
      "context": "app",
      "dockerfile": "app/Dockerfile",
      "target": "app",
      "destination": [
        "registry.example.com/both:latest"
      ]
    },
    "neither": {
      "target": "fallback",
      "destination": [
        "registry.example.com/neither:latest"
      ]
    },
    "only_context": {
      "context": "app",
      "target": "app",
      "destination": [
        "registry.example.com/only_context:latest"
      ]
    },
    "only_dockerfile": {
      "dockerfile": "Dockerfile.custom",
      "target": "custom_df",
      "destination": [
        "registry.example.com/only_dockerfile:latest"
      ]
    }
  }
}
